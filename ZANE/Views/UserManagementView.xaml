<UserControl x:Class="ZANE.Views.UserManagementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:ZANE.ViewModels"
             xmlns:auth="clr-namespace:ZANE.Models.Auth"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:RoleManagementViewModel}"
             d:DesignWidth="1400" d:DesignHeight="800"
             Background="{DynamicResource ContentBackgroundBrush}">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Title Bar -->
        <Border Grid.Row="0"
                Background="{DynamicResource ButtonBackgroundBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1" CornerRadius="8"
                Padding="20,12" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Role Management"
                           FontSize="24" FontWeight="Bold"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           VerticalAlignment="Center" />
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button Height="32" Padding="16,0"
                            Command="{Binding SavePermissionsCommand}"
                            Background="{DynamicResource PrimaryBrush}"
                            Foreground="{DynamicResource TextOnPrimaryBrush}"
                            BorderThickness="0" Cursor="Hand"
                            hc:BorderElement.CornerRadius="4">
                        <TextBlock Text="Save Permissions" FontSize="13" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Content -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- ═══ Left: Role Selector + Page Permissions ═══ -->
            <Border Grid.Column="0"
                    Background="{DynamicResource ButtonBackgroundBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Select Role"
                               FontSize="14" FontWeight="Bold"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               Margin="0,0,0,4" />
                    <hc:ComboBox Grid.Row="1" Height="30" Margin="0,0,0,6"
                                 ItemsSource="{Binding Roles}"
                                 SelectedValue="{Binding SelectedRole}"
                                 DisplayMemberPath="Name" />

                    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,6">
                        <Button Height="26" Width="26" Padding="0" Margin="0,0,4,0"
                                Command="{Binding OpenCreatePopupCommand}"
                                Background="{DynamicResource SuccessBrush}"
                                Foreground="White" BorderThickness="0"
                                Cursor="Hand" hc:BorderElement.CornerRadius="4"
                                FontSize="14" Content="+" ToolTip="New Role" />
                        <Button Height="26" Width="70" Padding="0" Margin="0,0,4,0"
                                Command="{Binding OpenEditPopupCommand}"
                                Background="{DynamicResource WarningBrush}"
                                Foreground="White" BorderThickness="0"
                                Cursor="Hand" hc:BorderElement.CornerRadius="4"
                                FontSize="11" Content="编辑用户" ToolTip="Edit Role Name" />
                        <Button Height="26" Width="70" Padding="0"
                                Command="{Binding DeleteRoleCommand}"
                                Background="{DynamicResource ErrorBrush}"
                                Foreground="White" BorderThickness="0"
                                Cursor="Hand" hc:BorderElement.CornerRadius="4"
                                FontSize="11" Content="删除用户" ToolTip="Delete Role" />
                    </StackPanel>

                    <Border Grid.Row="3" BorderThickness="0,1,0,0"
                            BorderBrush="{DynamicResource BorderBrush}"
                            Margin="0,0,0,4" />

                    <TextBlock Grid.Row="3" Text="Page Access"
                               FontSize="13" FontWeight="Bold"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               Margin="0,6,0,4" />

                    <ScrollViewer Grid.Row="4" VerticalScrollBarVisibility="Auto"
                                  BorderThickness="0">
                        <ItemsControl ItemsSource="{Binding MenuPermissions}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="auth:PermissionItem">
    <Grid Margin="0,3,0,3">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding DisplayName}"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                                   FontSize="12" VerticalAlignment="Center" />
                                        <CheckBox Grid.Column="1"
                                                  IsChecked="{Binding IsSelecked, Mode=OneWay}"
                                                  Command="{Binding RelativeSource={RelativeSource AncestorType=UserControl}, Path=DataContext.TogglePermissionCommand}"
                                                  CommandParameter="{Binding}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>


            <!-- ═══ Permission Columns ═══ -->
            <Border Grid.Column="2"
                    Background="{DynamicResource ButtonBackgroundBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Basic Parameters"
                                   FontSize="14" FontWeight="Bold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   VerticalAlignment="Center" />
                        <CheckBox Grid.Column="1" Content="All"
                                  Command="{Binding SelectAllInCategoryCommand}"
                                  CommandParameter="Device"
                                  Foreground="{DynamicResource TextPrimaryBrush}" />
                    </Grid>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                                  BorderThickness="0" Margin="0,4,0,0">
                        <ItemsControl ItemsSource="{Binding BasicPermissions}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="auth:PermissionItem">
    <Grid Margin="0,3,0,3">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding DisplayName}"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                                   VerticalAlignment="Center" />
                                        <CheckBox Grid.Column="1"
                                                  IsChecked="{Binding IsSelecked, Mode=OneWay}"
                                                  Command="{Binding RelativeSource={RelativeSource AncestorType=UserControl}, Path=DataContext.TogglePermissionCommand}"
                                                  CommandParameter="{Binding}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>

            <Border Grid.Column="4"
                    Background="{DynamicResource ButtonBackgroundBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Run Parameters"
                                   FontSize="14" FontWeight="Bold"
                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                        <CheckBox Grid.Column="1" Content="All"
                                  Command="{Binding SelectAllInCategoryCommand}"
                                  CommandParameter="Run"
                                  Foreground="{DynamicResource TextPrimaryBrush}" />
                    </Grid>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                                  BorderThickness="0" Margin="0,4,0,0">
                        <ItemsControl ItemsSource="{Binding RunPermissions}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="auth:PermissionItem">
    <Grid Margin="0,3,0,3">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding DisplayName}"
                                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                                        <CheckBox Grid.Column="1"
                                                  IsChecked="{Binding IsSelecked, Mode=OneWay}"
                                                  Command="{Binding RelativeSource={RelativeSource AncestorType=UserControl}, Path=DataContext.TogglePermissionCommand}"
                                                  CommandParameter="{Binding}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>

            <Border Grid.Column="6"
                    Background="{DynamicResource ButtonBackgroundBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Function Enables"
                                   FontSize="14" FontWeight="Bold"
                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                        <CheckBox Grid.Column="1" Content="All"
                                  Command="{Binding SelectAllInCategoryCommand}"
                                  CommandParameter="Function"
                                  Foreground="{DynamicResource TextPrimaryBrush}" />
                    </Grid>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                                  BorderThickness="0" Margin="0,4,0,0">
                        <ItemsControl ItemsSource="{Binding FunctionPermissions}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="auth:PermissionItem">
    <Grid Margin="0,3,0,3">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding DisplayName}"
                                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                                        <CheckBox Grid.Column="1"
                                                  IsChecked="{Binding IsSelecked, Mode=OneWay}"
                                                  Command="{Binding RelativeSource={RelativeSource AncestorType=UserControl}, Path=DataContext.TogglePermissionCommand}"
                                                  CommandParameter="{Binding}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>

            <Border Grid.Column="8"
                    Background="{DynamicResource ButtonBackgroundBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Advanced Settings"
                                   FontSize="14" FontWeight="Bold"
                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                        <CheckBox Grid.Column="1" Content="All"
                                  Command="{Binding SelectAllInCategoryCommand}"
                                  CommandParameter="Advanced"
                                  Foreground="{DynamicResource TextPrimaryBrush}" />
                    </Grid>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                                  BorderThickness="0" Margin="0,4,0,0">
                        <ItemsControl ItemsSource="{Binding AdvancedPermissions}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="auth:PermissionItem">
    <Grid Margin="0,3,0,3">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding DisplayName}"
                                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                                        <CheckBox Grid.Column="1"
                                                  IsChecked="{Binding IsSelecked, Mode=OneWay}"
                                                  Command="{Binding RelativeSource={RelativeSource AncestorType=UserControl}, Path=DataContext.TogglePermissionCommand}"
                                                  CommandParameter="{Binding}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>

        </Grid>

        <!-- ═══ Role Create/Edit Popup ═══ -->
        <Popup IsOpen="{Binding IsCreatePopupOpen}"
               AllowsTransparency="True" StaysOpen="False"
               Placement="Center" PopupAnimation="Slide">
            <Border Width="300" Padding="24"
                    Background="{DynamicResource ContentBackgroundBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1" CornerRadius="8">
                <StackPanel>
                    <TextBlock Text="Role Name" FontSize="18" FontWeight="Bold"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               Margin="0,0,0,16" />
                    <hc:TextBox Height="32"
                                hc:TitleElement.Title="Name"
                                hc:TitleElement.TitlePlacement="Left"
                                hc:TitleElement.TitleWidth="60"
                                Text="{Binding EditRoleName, Mode=TwoWay}" />
                    <Grid Margin="0,16,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="20" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Height="32"
                                Command="{Binding CreateRoleCommand}"
                                Background="{DynamicResource PrimaryBrush}"
                                Foreground="White" BorderThickness="0"
                                Cursor="Hand" hc:BorderElement.CornerRadius="4">
                            <TextBlock Text="OK" />
                        </Button>
                        <Button Grid.Column="2" Height="32"
                                Command="{Binding CancelPopupCommand}"
                                Background="{DynamicResource ButtonBackgroundBrush}"
                                Foreground="{DynamicResource TextPrimaryBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1" Cursor="Hand"
                                hc:BorderElement.CornerRadius="4">
                            <TextBlock Text="Cancel" />
                        </Button>
                    </Grid>
                </StackPanel>
            </Border>
        </Popup>
    </Grid>
</UserControl>
