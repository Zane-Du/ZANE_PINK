<UserControl x:Class="ZANE.Views.MainPageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:ZANE.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:MainPageViewModel}"
             Background="{DynamicResource ContentBackgroundBrush}">
    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 标题 -->
        <TextBlock Grid.Row="0" Text="{Binding WelcomeText}" 
                   FontSize="28" FontWeight="Bold"
                   Foreground="{DynamicResource TextPrimaryBrush}"
                   Margin="0,0,0,20" />

        <!-- 状态栏 -->
        <Border Grid.Row="1" 
                Background="{DynamicResource ButtonBackgroundBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1" CornerRadius="8"
                Padding="16,12" Margin="0,0,0,20">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="系统状态: " FontSize="14"
                           Foreground="{DynamicResource TextSecondaryBrush}" />
                <TextBlock Text="{Binding StatusText}" FontSize="14" FontWeight="SemiBold"
                           Foreground="{DynamicResource PrimaryBrush}" />
            </StackPanel>
        </Border>

        <!-- 功能按钮组 -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,20">
            <Button Command="{Binding GreetCommand}"
                    Background="{DynamicResource PrimaryBrush}"
                    Foreground="{DynamicResource TextOnPrimaryBrush}"
                    FontSize="14" FontWeight="SemiBold"
                    Padding="20,10" Cursor="Hand" Margin="0,0,12,0"
                    BorderThickness="0">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="👋" FontSize="18" Margin="0,0,8,0" />
                    <TextBlock Text="欢迎点击" />
                </StackPanel>
            </Button>

            <Button Command="{Binding ResetStatusCommand}"
                    Background="{DynamicResource ButtonBackgroundBrush}"
                    Foreground="{DynamicResource TextPrimaryBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    FontSize="14" Padding="16,10" Cursor="Hand">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="🔄" FontSize="16" Margin="0,0,8,0" />
                    <TextBlock Text="重置状态" />
                </StackPanel>
            </Button>
        </StackPanel>

        <!-- 内容卡片 -->
        <Border Grid.Row="3"
                Background="{DynamicResource ButtonBackgroundBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1" CornerRadius="8"
                Padding="24">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Text="🏠 欢迎使用 ZANE" FontSize="20" FontWeight="Bold"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           HorizontalAlignment="Center" Margin="0,0,0,16" />
                <TextBlock Text="基于 WPF + CommunityToolkit.MVVM 构建的工业控制系统框架" 
                           FontSize="14" Foreground="{DynamicResource TextSecondaryBrush}"
                           HorizontalAlignment="Center" TextWrapping="Wrap" Margin="0,0,0,16" />
                <TextBlock Text="左侧导航栏包含 17 个功能页面，上方工具栏提供快捷操作" 
                           FontSize="14" Foreground="{DynamicResource TextSecondaryBrush}"
                           HorizontalAlignment="Center" TextWrapping="Wrap" Margin="0,0,0,16" />
                <TextBlock Text="点击右下角 ☀️/🌙 按钮切换浅色/深色主题" 
                           FontSize="14" Foreground="{DynamicResource TextSecondaryBrush}"
                           HorizontalAlignment="Center" TextWrapping="Wrap" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
