<UserControl x:Class="ZANE.Views.ControlPanelView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:ZANE.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:ControlPanelViewModel}"
             Background="{DynamicResource ContentBackgroundBrush}">
    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 标题 -->
        <TextBlock Grid.Row="0" Text="🎛️ 控制面板" 
                   FontSize="28" FontWeight="Bold"
                   Foreground="{DynamicResource TextPrimaryBrush}"
                   Margin="0,0,0,20" />

        <!-- 系统状态 -->
        <Border Grid.Row="1"
                Background="{DynamicResource ButtonBackgroundBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1" CornerRadius="8"
                Padding="16" Margin="0,0,0,16">
            <StackPanel Orientation="Horizontal">
                <StackPanel Orientation="Horizontal" Margin="0,0,24,0">
                    <TextBlock Text="系统状态:" FontSize="14"
                               Foreground="{DynamicResource TextSecondaryBrush}" />
                    <TextBlock Text="{Binding SystemState}" FontSize="14" FontWeight="Bold" Margin="8,0,0,0"
                               Foreground="{DynamicResource PrimaryBrush}" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,0,24,0">
                    <TextBlock Text="最近操作:" FontSize="14"
                               Foreground="{DynamicResource TextSecondaryBrush}" />
                    <TextBlock Text="{Binding LastAction}" FontSize="14" Margin="8,0,0,0"
                               Foreground="{DynamicResource TextPrimaryBrush}" />
                </StackPanel>

                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="进度:" FontSize="14"
                               Foreground="{DynamicResource TextSecondaryBrush}" />
                    <ProgressBar Value="{Binding ProgressValue}" Width="120" Height="16" Margin="8,0,0,0"
                                 Foreground="{DynamicResource PrimaryBrush}"
                                 Background="{DynamicResource ButtonBackgroundBrush}"
                                 BorderBrush="{DynamicResource BorderBrush}" />
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- 控制按钮组 -->
        <WrapPanel Grid.Row="2" Margin="0,0,0,20" HorizontalAlignment="Center">
            <Button Command="{Binding StartSystemCommand}"
                    Background="#FF4CAF50"
                    Foreground="White"
                    BorderThickness="0" 
                    Width="140" Height="80" Margin="8"
                    Cursor="Hand">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="▶️" FontSize="28" TextAlignment="Center" />
                    <TextBlock Text="启动系统" FontSize="13" TextAlignment="Center" Margin="0,4,0,0" />
                </StackPanel>
            </Button>

            <Button Command="{Binding StopSystemCommand}"
                    Background="#FFFF9800"
                    Foreground="White"
                    BorderThickness="0"
                    Width="140" Height="80" Margin="8"
                    Cursor="Hand">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="⏹️" FontSize="28" TextAlignment="Center" />
                    <TextBlock Text="停止系统" FontSize="13" TextAlignment="Center" Margin="0,4,0,0" />
                </StackPanel>
            </Button>

            <Button Command="{Binding EmergencyStopCommand}"
                    Background="#FFF44336"
                    Foreground="White"
                    BorderThickness="0"
                    Width="140" Height="80" Margin="8"
                    Cursor="Hand">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="🛑" FontSize="28" TextAlignment="Center" />
                    <TextBlock Text="紧急停止" FontSize="13" TextAlignment="Center" Margin="0,4,0,0" />
                </StackPanel>
            </Button>

            <Button Command="{Binding RunDiagnosticCommand}"
                    Background="{DynamicResource PrimaryBrush}"
                    Foreground="{DynamicResource TextOnPrimaryBrush}"
                    BorderThickness="0"
                    Width="140" Height="80" Margin="8"
                    Cursor="Hand">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="🔬" FontSize="28" TextAlignment="Center" />
                    <TextBlock Text="运行诊断" FontSize="13" TextAlignment="Center" Margin="0,4,0,0" />
                </StackPanel>
            </Button>
        </WrapPanel>

        <!-- 日志区域 -->
        <TextBlock Grid.Row="3" Text="实时日志" FontSize="16" FontWeight="SemiBold"
                   Foreground="{DynamicResource TextPrimaryBrush}"
                   Margin="0,0,0,8" />

        <Border Grid.Row="4"
                Background="{DynamicResource ContentBackgroundBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1" CornerRadius="8"
                Padding="16">
            <ScrollViewer>
                <TextBlock Text="系统启动中...&#x0a;所有模块加载完成&#x0a;等待操作指令..."
                           FontFamily="Consolas" FontSize="12"
                           Foreground="{DynamicResource TextSecondaryBrush}" />
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
