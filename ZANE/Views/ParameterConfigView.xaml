<UserControl x:Class="ZANE.Views.ParameterConfigView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:ZANE.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:ParameterConfigViewModel}"
             d:DesignWidth="1400" d:DesignHeight="800"
             Background="{DynamicResource ContentBackgroundBrush}">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Title Bar -->
        <Border Grid.Row="0"
                Background="{DynamicResource ButtonBackgroundBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1" CornerRadius="8"
                Padding="20,12" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Parameter Config"
                           FontSize="24" FontWeight="Bold"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" Orientation="Horizontal"
                            HorizontalAlignment="Center" VerticalAlignment="Center">
                    <hc:ComboBox MinWidth="200" Height="32" Margin="0,0,8,0"
                                 ItemsSource="{Binding RecipeList}"
                                 SelectedValue="{Binding SelectedRecipe}" />
                    <Button Height="32" Padding="12,0" Margin="0,0,4,0"
                            Command="{Binding OpenNewRecipePopupCommand}"
                            Background="{DynamicResource SuccessBrush}"
                            Foreground="White" BorderThickness="0"
                            Cursor="Hand" hc:BorderElement.CornerRadius="4">
                        <TextBlock Text="+ New Recipe" FontSize="13" />
                    </Button>
                    <Button Height="32" Padding="12,0"
                            Command="{Binding DeleteRecipeCommand}"
                            Background="{DynamicResource ErrorBrush}"
                            Foreground="White" BorderThickness="0"
                            Cursor="Hand" hc:BorderElement.CornerRadius="4">
                        <TextBlock Text="Delete" FontSize="13" />
                    </Button>
                </StackPanel>
                <Button Grid.Column="2" Height="32" Padding="16,0"
                        Command="{Binding SaveConfigCommand}"
                        Background="{DynamicResource PrimaryBrush}"
                        Foreground="{DynamicResource TextOnPrimaryBrush}"
                        BorderThickness="0" Cursor="Hand"
                        hc:BorderElement.CornerRadius="4">
                    <StackPanel Orientation="Horizontal">
                        <!--<TextBlock Text="Save" Margin="0,0,8,0" />-->
                        <TextBlock Text="保存" FontSize="13" />
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <!-- New Recipe Popup -->
        <Popup IsOpen="{Binding IsNewRecipePopupOpen}"
               AllowsTransparency="True" StaysOpen="False"
               Placement="Center" PopupAnimation="Slide">
            <Border Width="320" Padding="24"
                    Background="{DynamicResource ContentBackgroundBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1" CornerRadius="8">
                <StackPanel>
                    <TextBlock Text="New Recipe" FontSize="18" FontWeight="Bold"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               Margin="0,0,0,16" />
                    <hc:TextBox Height="32"
                                hc:TitleElement.Title="Recipe Name"
                                hc:TitleElement.TitlePlacement="Left"
                                hc:TitleElement.TitleWidth="90"
                                Text="{Binding NewRecipeName, Mode=TwoWay}" />
                    <Grid Margin="0,16,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="20" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Height="32"
                                Command="{Binding CreateRecipeCommand}"
                                Background="{DynamicResource PrimaryBrush}"
                                Foreground="White" BorderThickness="0"
                                Cursor="Hand" hc:BorderElement.CornerRadius="4">
                            <TextBlock Text="Create" />
                        </Button>
                        <Button Grid.Column="2" Height="32"
                                Command="{Binding OpenNewRecipePopupCommand}"
                                Background="{DynamicResource ButtonBackgroundBrush}"
                                Foreground="{DynamicResource TextPrimaryBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1" Cursor="Hand"
                                hc:BorderElement.CornerRadius="4">
                            <TextBlock Text="Cancel" />
                        </Button>
                    </Grid>
                </StackPanel>
            </Border>
        </Popup>

        <!-- 4-Column Panels (each scrolls independently) -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Background="{DynamicResource ButtonBackgroundBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1" CornerRadius="8"
                    Padding="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="Basic Parameters"
                               FontSize="16" FontWeight="Bold"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               Margin="0,0,0,8" />
                    <ScrollViewer Grid.Row="1"
                                  VerticalScrollBarVisibility="Auto"
                                  BorderThickness="0"
                                  Content="{Binding DeviceParameterPanel}" />
                </Grid>
            </Border>

            <Border Grid.Column="2"
                    Background="{DynamicResource ButtonBackgroundBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1" CornerRadius="8"
                    Padding="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="Run Parameters"
                               FontSize="16" FontWeight="Bold"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               Margin="0,0,0,8" />
                    <ScrollViewer Grid.Row="1"
                                  VerticalScrollBarVisibility="Auto"
                                  BorderThickness="0"
                                  Content="{Binding RunParameterPanel}" />
                </Grid>
            </Border>

            <Border Grid.Column="4"
                    Background="{DynamicResource ButtonBackgroundBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1" CornerRadius="8"
                    Padding="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="Function Enables"
                               FontSize="16" FontWeight="Bold"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               Margin="0,0,0,8" />
                    <ScrollViewer Grid.Row="1"
                                  VerticalScrollBarVisibility="Auto"
                                  BorderThickness="0"
                                  Content="{Binding FunctionEnablePanel}" />
                </Grid>
            </Border>

            <Border Grid.Column="6"
                    Background="{DynamicResource ButtonBackgroundBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1" CornerRadius="8"
                    Padding="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="Advanced Settings"
                               FontSize="16" FontWeight="Bold"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               Margin="0,0,0,8" />
                    <ScrollViewer Grid.Row="1"
                                  VerticalScrollBarVisibility="Auto"
                                  BorderThickness="0"
                                  Content="{Binding AdvancedConfigPanel}" />
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>