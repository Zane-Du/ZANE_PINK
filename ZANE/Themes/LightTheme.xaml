<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- 主色调 -->
    <Color x:Key="PrimaryColor">#FFE91E63</Color>
    <SolidColorBrush x:Key="PrimaryBrush" Color="#FFE91E63" />

    <!-- 背景色 -->
    <Color x:Key="WindowBackgroundColor">#FFF5F5F5</Color>
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#FFF5F5F5" />

    <Color x:Key="ContentBackgroundColor">#FFFFFFFF</Color>
    <SolidColorBrush x:Key="ContentBackgroundBrush" Color="#FFFFFFFF" />

    <Color x:Key="SidebarBackgroundColor">#FFFAFAFA</Color>
    <SolidColorBrush x:Key="SidebarBackgroundBrush" Color="#FFFAFAFA" />

    <!-- 文字色 -->
    <Color x:Key="TextPrimaryColor">#FF1A1A1A</Color>
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#FF1A1A1A" />

    <Color x:Key="TextSecondaryColor">#FF666666</Color>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#FF666666" />

    <Color x:Key="TextOnPrimaryColor">#FFFFFFFF</Color>
    <SolidColorBrush x:Key="TextOnPrimaryBrush" Color="#FFFFFFFF" />

    <!-- 边框/分隔线 -->
    <Color x:Key="BorderColor">#FFE0E0E0</Color>
    <SolidColorBrush x:Key="BorderBrush" Color="#FFE0E0E0" />

    <Color x:Key="DividerColor">#FFEEEEEE</Color>
    <SolidColorBrush x:Key="DividerBrush" Color="#FFEEEEEE" />

    <!-- 导航选中 -->
    <Color x:Key="NavSelectedBackgroundColor">#20E91E63</Color>
    <SolidColorBrush x:Key="NavSelectedBackgroundBrush" Color="#20E91E63" />


    <Color x:Key="NavHoverBackgroundColor">#FFE0E0E0</Color>
    <SolidColorBrush x:Key="NavHoverBackgroundBrush" Color="#FFE0E0E0" />

    <!-- 工具栏背景 -->
    <Color x:Key="ToolbarBackgroundColor">#FFFFFFFF</Color>
    <SolidColorBrush x:Key="ToolbarBackgroundBrush" Color="#FFFFFFFF" />

    <!-- 按钮 -->
    <Color x:Key="ButtonBackgroundColor">#FFF0F0F0</Color>
    <SolidColorBrush x:Key="ButtonBackgroundBrush" Color="#FFF0F0F0" />

    <Color x:Key="ButtonHoverBackgroundColor">#FFE0E0E0</Color>
    <SolidColorBrush x:Key="ButtonHoverBackgroundBrush" Color="#FFE0E0E0" />

    <!-- 通用悬停/输入框 -->
    <Color x:Key="HoverBackgroundColor">#10000000</Color>
    <SolidColorBrush x:Key="HoverBackgroundBrush" Color="#10000000" />

    <Color x:Key="InputBackgroundColor">#FFF0F0F0</Color>
    <SolidColorBrush x:Key="InputBackgroundBrush" Color="#FFF0F0F0" />

    <Color x:Key="SecondaryBorderColor">#FFCCCCCC</Color>
    <SolidColorBrush x:Key="SecondaryBorderBrush" Color="#FFCCCCCC" />

    <!-- Logo 相关 -->
    <Color x:Key="LogoBackgroundColor">#FFE91E63</Color>
    <SolidColorBrush x:Key="LogoBackgroundBrush" Color="#FFE91E63" />
    <Color x:Key="LogoTextColor">#FFFFFFFF</Color>
    <SolidColorBrush x:Key="LogoTextBrush" Color="#FFFFFFFF" />

    <!-- 滚动条 -->
    <Color x:Key="ScrollBarColor">#40000000</Color>
    <SolidColorBrush x:Key="ScrollBarBrush" Color="#40000000" />

    <!-- 阴影 -->
    <Color x:Key="ShadowColor">#1A000000</Color>
    <SolidColorBrush x:Key="ShadowBrush" Color="#1A000000" />

    <!-- 状态颜色 -->
    <Color x:Key="SuccessColor">#FF27AE60</Color>
    <SolidColorBrush x:Key="SuccessBrush" Color="#FF27AE60" />

    <Color x:Key="ErrorColor">#FFE74C3C</Color>
    <SolidColorBrush x:Key="ErrorBrush" Color="#FFE74C3C" />

    <Color x:Key="WarningColor">#FFF39C12</Color>
    <SolidColorBrush x:Key="WarningBrush" Color="#FFF39C12" />

</ResourceDictionary>
