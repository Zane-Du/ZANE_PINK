<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- 主色调 -->
    <Color x:Key="PrimaryColor">#FFFF4081</Color>
    <SolidColorBrush x:Key="PrimaryBrush" Color="#FFFF4081" />

    <!-- 背景色 -->
    <Color x:Key="WindowBackgroundColor">#FF1A1A2E</Color>
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#FF1A1A2E" />

    <Color x:Key="ContentBackgroundColor">#FF16213E</Color>
    <SolidColorBrush x:Key="ContentBackgroundBrush" Color="#FF16213E" />

    <Color x:Key="SidebarBackgroundColor">#FF0F3460</Color>
    <SolidColorBrush x:Key="SidebarBackgroundBrush" Color="#FF0F3460" />

    <!-- 文字色 -->
    <Color x:Key="TextPrimaryColor">#FFE0E0E0</Color>
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#FFE0E0E0" />

    <Color x:Key="TextSecondaryColor">#FF999999</Color>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#FF999999" />

    <Color x:Key="TextOnPrimaryColor">#FFFFFFFF</Color>
    <SolidColorBrush x:Key="TextOnPrimaryBrush" Color="#FFFFFFFF" />

    <!-- 边框/分隔线 -->
    <Color x:Key="BorderColor">#FF2A2A4A</Color>
    <SolidColorBrush x:Key="BorderBrush" Color="#FF2A2A4A" />

    <Color x:Key="DividerColor">#FF2A2A4A</Color>
    <SolidColorBrush x:Key="DividerBrush" Color="#FF2A2A4A" />

    <!-- 导航选中 -->
    <Color x:Key="NavSelectedBackgroundColor">#40FF4081</Color>
    <SolidColorBrush x:Key="NavSelectedBackgroundBrush" Color="#40FF4081" />

    <Color x:Key="NavHoverBackgroundColor">#FF2A2A5A</Color>
    <SolidColorBrush x:Key="NavHoverBackgroundBrush" Color="#FF2A2A5A" />

    <!-- 工具栏背景 -->
    <Color x:Key="ToolbarBackgroundColor">#FF0F3460</Color>
    <SolidColorBrush x:Key="ToolbarBackgroundBrush" Color="#FF0F3460" />

    <!-- 按钮 -->
    <Color x:Key="ButtonBackgroundColor">#FF2A2A4A</Color>
    <SolidColorBrush x:Key="ButtonBackgroundBrush" Color="#FF2A2A4A" />

    <Color x:Key="ButtonHoverBackgroundColor">#FF3A3A5A</Color>
    <SolidColorBrush x:Key="ButtonHoverBackgroundBrush" Color="#FF3A3A5A" />

    <!-- 通用悬停/输入框 -->
    <Color x:Key="HoverBackgroundColor">#20FFFFFF</Color>
    <SolidColorBrush x:Key="HoverBackgroundBrush" Color="#20FFFFFF" />

    <Color x:Key="InputBackgroundColor">#FF1E1E3E</Color>
    <SolidColorBrush x:Key="InputBackgroundBrush" Color="#FF1E1E3E" />

    <Color x:Key="SecondaryBorderColor">#FF3A3A5A</Color>
    <SolidColorBrush x:Key="SecondaryBorderBrush" Color="#FF3A3A5A" />

    <!-- Logo 相关 -->
    <Color x:Key="LogoBackgroundColor">#FFFF4081</Color>
    <SolidColorBrush x:Key="LogoBackgroundBrush" Color="#FFFF4081" />
    <Color x:Key="LogoTextColor">#FFFFFFFF</Color>
    <SolidColorBrush x:Key="LogoTextBrush" Color="#FFFFFFFF" />

    <!-- 滚动条 -->
    <Color x:Key="ScrollBarColor">#60FFFFFF</Color>
    <SolidColorBrush x:Key="ScrollBarBrush" Color="#60FFFFFF" />

    <!-- 阴影 -->
    <Color x:Key="ShadowColor">#33000000</Color>
    <SolidColorBrush x:Key="ShadowBrush" Color="#33000000" />

    <!-- 状态颜色 -->
    <Color x:Key="SuccessColor">#FF2ECC71</Color>
    <SolidColorBrush x:Key="SuccessBrush" Color="#FF2ECC71" />

    <Color x:Key="ErrorColor">#FFE74C3C</Color>
    <SolidColorBrush x:Key="ErrorBrush" Color="#FFE74C3C" />

    <Color x:Key="WarningColor">#FFF39C12</Color>
    <SolidColorBrush x:Key="WarningBrush" Color="#FFF39C12" />

</ResourceDictionary>
