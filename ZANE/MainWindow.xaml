<Window x:Class="ZANE.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:hc="https://handyorg.github.io/handycontrol"
        xmlns:vm="clr-namespace:ZANE.ViewModels"
        xmlns:views="clr-namespace:ZANE.Views"
        xmlns:models="clr-namespace:ZANE.Models"
        mc:Ignorable="d"
        Title="ZANE" 
        Width="1400" Height="800"
        d:DesignWidth="1400" d:DesignHeight="800"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        d:DataContext="{d:DesignInstance vm:MainViewModel}">

    <Window.Resources>
        <!-- DataTemplate 映射 17 个 ViewModel → View -->
        <DataTemplate DataType="{x:Type vm:MainPageViewModel}"><views:MainPageView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:LogAnalysisViewModel}"><views:LogAnalysisView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:ParameterConfigViewModel}"><views:ParameterConfigView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:ChartDisplayViewModel}"><views:ChartDisplayView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:ControlPanelViewModel}"><views:ControlPanelView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:MESTestViewModel}"><views:MESTestView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:CameraCalibViewModel}"><views:CameraCalibView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:ImageDisplayViewModel}"><views:ImageDisplayView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:MotionControlViewModel}"><views:MotionControlView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:AspNetViewModel}"><views:AspNetView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:ProductionHistoryViewModel}"><views:ProductionHistoryView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:DeviceConfigViewModel}"><views:DeviceConfigView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:SignalConfigViewModel}"><views:SignalConfigView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:RoleManagementViewModel}"><views:UserManagementView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:UserManagementPageViewModel}"><views:TestPage1View /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:TestPage2ViewModel}"><views:TestPage2View /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:TestPage3ViewModel}"><views:TestPage3View /></DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="{Binding SidebarWidth, Mode=TwoWay}" />
            <ColumnDefinition Width="5" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ====== 左侧导航栏 ====== -->
        <Border Grid.Column="0"
                Background="{DynamicResource SidebarBackgroundBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Logo 区域 -->
                <Border Grid.Row="0" Height="64"
                        Background="{DynamicResource SidebarBackgroundBrush}"
                        BorderBrush="{DynamicResource DividerBrush}"
                        BorderThickness="0,0,0,1">
                    <Grid Margin="16,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- 粉色 Z Logo -->
                        <Border Grid.Column="0"
                                Width="36" Height="36"
                                Background="{DynamicResource LogoBackgroundBrush}"
                                CornerRadius="8">
                            <TextBlock Text="Z"
                                       FontSize="20" FontWeight="Black"
                                       Foreground="{DynamicResource LogoTextBrush}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Border>

                        <!-- 品牌名 -->
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0,0,0">
                            <TextBlock Text="ZANE" FontSize="16" FontWeight="Bold"
                                       Foreground="{DynamicResource TextPrimaryBrush}" />
                            <TextBlock Text="控制系统" FontSize="11"
                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- 导航项列表 -->
                <ScrollViewer Grid.Row="1"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Margin="0,8,0,0">
                    <ItemsControl ItemsSource="{Binding NavItems}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type models:NavigationItem}">
                                <Border x:Name="NavBorder"
                                        Height="44" Margin="4,2"
                                        CornerRadius="8" Padding="12,0"
                                        Cursor="Hand"
                                        MouseDown="NavItem_Click"
                                        DataContext="{Binding}">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="Transparent" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource NavSelectedBackgroundBrush}" />
                                                </DataTrigger>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource NavHoverBackgroundBrush}" />
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="28" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <!-- 图标 -->
                                        <TextBlock Grid.Column="0"
                                                   Text="{Binding Icon}"
                                                   FontSize="16"
                                                   VerticalAlignment="Center"
                                                   HorizontalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                                                    <Style.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}" />
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>

                                        <!-- 标题 -->
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding Title}"
                                                   FontSize="14"
                                                   VerticalAlignment="Center"
                                                   Margin="8,0,0,0">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                                                    <Style.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}" />
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!-- 底部占位 -->
                <Border Grid.Row="2"
                        Background="{DynamicResource SidebarBackgroundBrush}"
                        Height="4" />
            </Grid>
        </Border>

        <!-- ====== 可拖拽分隔条 ====== -->
        <Border Grid.Column="1"
                x:Name="SplitterBorder"
                Width="5"
                Cursor="SizeWE"
                Background="Transparent"
                MouseLeftButtonDown="Splitter_MouseLeftButtonDown"
                MouseLeftButtonUp="Splitter_MouseLeftButtonUp"
                MouseMove="Splitter_MouseMove">
            <Border.Style>
                <Style TargetType="Border">
                    <Style.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="{DynamicResource PrimaryBrush}" />
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
        </Border>

        <!-- ====== 右侧内容区域 ====== -->
        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="48" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- 顶部工具栏（可拖拽窗口） -->
            <Border Grid.Row="0"
                    x:Name="ToolbarBorder"
                    Background="{DynamicResource ToolbarBackgroundBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0,0,0,1"
                    Padding="16,0"
                    MouseLeftButtonDown="Toolbar_MouseLeftButtonDown">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <ItemsControl ItemsSource="{Binding TopMenuItems}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type models:TopMenuItem}">
                                <Button Click="TopMenuButton_Click"
                                        DataContext="{Binding}"
                                        Tag="{Binding}"
                                        Cursor="Hand"
                                        BorderThickness="0"
                                        Background="Transparent"
                                        Padding="12,0"
                                        Height="32"
                                        Margin="2,0">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Icon}" FontSize="14" Margin="0,0,6,0" />
                                        <TextBlock Text="{Binding Header}" FontSize="13"
                                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                                        <TextBlock Text=" ▾" FontSize="10"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- 窗口控制按钮 -->
                    <Separator Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}" Margin="8,0" />

                    <Button x:Name="MinimizeBtn" Width="36" Height="28"
                            Background="Transparent" BorderThickness="0"
                            Cursor="Hand" Click="MinimizeBtn_Click">
                        <TextBlock Text="─" FontSize="14" Foreground="{DynamicResource TextPrimaryBrush}" />
                    </Button>

                    <Button x:Name="MaximizeBtn" Width="36" Height="28"
                            Background="Transparent" BorderThickness="0"
                            Cursor="Hand" Click="MaximizeBtn_Click">
                        <TextBlock x:Name="MaximizeIcon" Text="☐" FontSize="14" Foreground="{DynamicResource TextPrimaryBrush}" />
                    </Button>

                    <Button x:Name="CloseBtn" Width="36" Height="28"
                            Background="Transparent" BorderThickness="0"
                            Cursor="Hand" Click="CloseBtn_Click">
                        <TextBlock Text="✕" FontSize="14" Foreground="{DynamicResource TextPrimaryBrush}" />
                    </Button>
                </StackPanel>
            </Border>

            <!-- 内容区域 -->
            <ContentControl Grid.Row="1"
                            Content="{Binding CurrentViewModel}"
                            Focusable="False" />

            <!-- 通知浮层容器（右下角纵向堆叠） -->
            <ItemsControl x:Name="NotificationContainer"
                          Grid.Row="1"
                          HorizontalAlignment="Right"
                          VerticalAlignment="Bottom"
                          Margin="0,0,20,20"
                          Panel.ZIndex="100"
                          IsHitTestVisible="False">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Vertical" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border x:Name="NotifBorder"
                               
                                Padding="14,10"
                                Margin="0,0,0,8"
                                CornerRadius="8"
                                BorderThickness="1"
                                Opacity="0">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="{DynamicResource ContentBackgroundBrush}" />
                                    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
                                </Style>
                            </Border.Style>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Column="0" Grid.RowSpan="2"
                                           x:Name="NotifIcon"
                                           FontSize="16" FontWeight="Bold"
                                           VerticalAlignment="Center"
                                           Margin="0,0,10,0" />
                                <TextBlock Grid.Column="1" Grid.Row="0"
                                           x:Name="NotifTime"
                                           FontSize="11"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           Margin="0,0,0,4" />
                                <TextBlock Grid.Column="1" Grid.Row="1"
                                           x:Name="NotifText"
                                           FontSize="13"
                                           TextWrapping="Wrap"
                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                           VerticalAlignment="Center"
                                           MaxHeight="60" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <ContentControl Grid.Row="1"
                            Content="{Binding CurrentViewModel}"
                            Focusable="False" />
        </Grid>
        <!-- ═══ 登录弹窗 ═══ -->
        <Popup IsOpen="{Binding LoginPopupOpen}"
               AllowsTransparency="True" StaysOpen="False"
               Placement="Center" PopupAnimation="Slide"
               Panel.ZIndex="200">
            <Border Width="340" Padding="24"
                    Background="{DynamicResource ContentBackgroundBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1" CornerRadius="8">
                <StackPanel>
                    <TextBlock Text="Login" FontSize="20" FontWeight="Bold"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               Margin="0,0,0,20" />
                    <hc:TextBox Height="34" Margin="0,0,0,12"
                                hc:TitleElement.Title="Account"
                                hc:TitleElement.TitlePlacement="Left"
                                hc:TitleElement.TitleWidth="80"
                                Text="{Binding LoginAccount, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <hc:TextBox Height="34" Margin="0,0,0,4"
                                hc:TitleElement.Title="Password"
                                hc:TitleElement.TitlePlacement="Left"
                                hc:TitleElement.TitleWidth="80"
                                Text="{Binding LoginPassword, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Text="{Binding LoginError}"
                               Foreground="{DynamicResource ErrorBrush}"
                               FontSize="13" Margin="0,0,0,12" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Height="34"
                                Command="{Binding LoginCommand}"
                                Background="{DynamicResource PrimaryBrush}"
                                Foreground="White" BorderThickness="0"
                                Cursor="Hand" hc:BorderElement.CornerRadius="4"
                                IsDefault="True">
                            <TextBlock Text="Login" FontSize="14" />
                        </Button>
                        <Button Grid.Column="2" Height="34"
                                Command="{Binding CancelLoginCommand}"
                                Background="{DynamicResource ButtonBackgroundBrush}"
                                Foreground="{DynamicResource TextPrimaryBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1" Cursor="Hand"
                                hc:BorderElement.CornerRadius="4"
                                IsCancel="True">
                            <TextBlock Text="Cancel" FontSize="14" />
                        </Button>
                    </Grid>
                </StackPanel>
            </Border>
        </Popup>

        <!-- ═══ Growl 通知容器（右下角） ═══ -->
        <StackPanel VerticalAlignment="Bottom" HorizontalAlignment="Right"
                    Margin="0,0,20,20" Panel.ZIndex="200"
                    Grid.ColumnSpan="3" hc:Growl.GrowlParent="True" />

    </Grid>
</Window>
